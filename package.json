{
  "name": "nuxt_AI",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "preview": "nuxt preview",
    "server": "node --env-file-if-exists=.env .output/server/index.mjs",
    "pm": "pm2 start ecosystem.config.cjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
