    "@nuxtjs/i18n": "10.6.0",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.5.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vue-advanced-cropper": "^2.8.9"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
