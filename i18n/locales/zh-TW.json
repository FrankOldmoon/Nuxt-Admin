      },
      "security": {
        "title": "安全與 SSO",
        "desc": "驗證碼、登錄失敗鎖定、最後登錄信息追蹤，以及 GitHub OAuth2 第三方登錄。"
      },
      "metadata": {
        "title": "Schema 自動發現",
        "desc": "任意 Drizzle 表即可瞬間得到完整 CRUD 頁面；通過註冊表可按表覆蓋 API 或 UI，還能為欄位定製 getter/setter 轉換。"
      },
      "realtime": {
        "title": "實時通知",
        "desc": "通過 WebSocket 推送實時未讀通知與消息。"
      },
      "llm": {
        "title": "LLM 集成",
        "desc": "管理大模型配置，並可一鍵測試連接是否可用。"
      },
      "i18n": {
        "title": "多語言支持",
        "desc": "內置中英文，隨時可從頂部欄切換。"
      },
      "config": {
        "title": "菜單與系統配置",
        "desc": "就地編輯側邊欄菜單，並在同一面板中調整 SMTP、安全、上傳與 LLM 等設置。"
      }
