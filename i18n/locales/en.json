    "welcome": "Hello World",
    "heroDescription": "A metadata-driven admin framework with CRUD, RBAC, SSO, real-time and LLM features.",
    "hero": {
      "badge": "Metadata-driven admin framework",
      "title": "Build enterprise back-office systems, faster",
      "subtitle": "A production-grade admin demo powered by Nuxt 4 — tables, forms, RBAC, security and LLM features driven by database metadata instead of hand-written code.",
      "cta": "Explore the dashboard",
      "ctaReturn": "Open the dashboard",
      "ctaSecondary": "View source"
    },
    "sectionFeatures": "Core capabilities",
    "sectionFeaturesHint": "Everything a modern admin system needs, out of the box.",
    "feature": {
      "crud": {
        "title": "Generic CRUD",
        "desc": "Metadata-driven tables, forms and details with search, filters, sorting, import/export, batch actions and trash."
      },
      "rbac": {
        "title": "RBAC & Permissions",
        "desc": "Role–menu–data–button permissions for fine-grained access control."
      },
      "security": {
        "title": "Security & SSO",
        "desc": "Captcha, failed-login lockout, last-login tracking and third-party sign-in via GitHub OAuth2."
      },
      "metadata": {
        "title": "Schema Auto-discovery",
        "desc": "Any Drizzle table becomes a full CRUD page instantly; a registry lets you override API or UI per table, and add per-field getter/setter transforms."
      },
      "realtime": {
        "title": "Real-time Notifications",
        "desc": "Live unread notifications and messages pushed over WebSocket."
      },
      "llm": {
        "title": "LLM Integration",
        "desc": "Manage provider settings and verify connectivity with a one-click test."
      },
      "i18n": {
        "title": "i18n Ready",
        "desc": "English and Chinese built in, switchable from the header at any time."
      },
      "config": {
        "title": "Menu & System Config",
        "desc": "Edit the sidebar menu in place and fine-tune SMTP, security, upload and LLM settings from one panel."
      }
    },
    "sectionTech": "Powered by",
    "cta": {
      "title": "Ready to see it in action?",
      "desc": "Jump into the dashboard and put the demo through its paces."
    }
