    "feature": {
      "crud": {
        "title": "通用 CRUD",
        "desc": "由元数据驱动的表格、表单与详情，内置搜索、筛选、排序、导入导出、批量操作与回收站。"
      },
      "rbac": {
        "title": "RBAC 与权限",
        "desc": "角色—菜单—数据—按钮四级权限，实现细粒度访问控制。"
      },
      "security": {
        "title": "安全与 SSO",
        "desc": "验证码、登录失败锁定、最后登录信息追踪，以及 GitHub OAuth2 第三方登录。"
      },
      "metadata": {
        "title": "Schema 自动发现",
        "desc": "任意 Drizzle 表即可瞬间得到完整 CRUD 页面；通过注册表可按表覆盖 API 或 UI，还能为字段定制 getter/setter 转换。"
      },
      "realtime": {
        "title": "实时通知",
        "desc": "通过 WebSocket 推送实时未读通知与消息。"
      },
      "llm": {
        "title": "LLM 集成",
        "desc": "管理大模型配置，并可一键测试连接是否可用。"
      },
      "i18n": {
        "title": "多语言支持",
        "desc": "内置中英文，随时可从顶部栏切换。"
      },
      "config": {
        "title": "菜单与系统配置",
        "desc": "就地编辑侧边栏菜单，并在同一面板中调整 SMTP、安全、上传与 LLM 等设置。"
      }
