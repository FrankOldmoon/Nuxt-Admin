# Nuxt
# NUXT_PUBLIC_SITE_URL=https://example.com

# Dev server
# NUXT_HOST=0.0.0.0
# NUXT_PORT=3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nuxt_ai
# Migrations:
# - Development (NODE_ENV !== 'production') applies base + module migrations on boot.
# - Production instances never migrate on boot; run `pnpm db:migrate:release` once
#   in the release pipeline before starting new instances.
# AUTO_MIGRATE is no longer used.
# Connection pool tuning (optional, defaults shown):
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECT_TIMEOUT=2000

# Session
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change_me_to_a_long_random_secret_value

# Initial admin account (production REQUIRES SEED_ADMIN_PASSWORD on first start;
# demo users with known passwords are seeded in development only)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=

# Private file signed URLs (falls back to NUXT_SESSION_PASSWORD when unset)
# FILE_SIGNING_SECRET=another_long_random_secret

# Modules (build-time; space/comma separated module IDs from modules.catalog.ts)
# Defaults to `example`. The SIS/SMS module lives in its own repository and must
# be cloned into modules/<id> and registered in modules.catalog.ts to be enabled.
# ENABLED_MODULES=example,sms
# BLOG_ENABLED=false

# Realtime (multi-instance deployments must use `postgres`)
# REALTIME_DRIVER=memory
# REALTIME_CHANNEL=app_realtime

# LLM (OpenAI-compatible API; env values override the dashboard "LLM" settings)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Retries per model turn for transient upstream errors (default 7)
# LLM_RETRIES=7
